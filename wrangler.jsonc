{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "localforge-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
